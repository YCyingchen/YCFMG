#!/bin/bash
# 安装后回调：初始化配置与数据目录（无安装向导，安装后开箱即用）
set -u
BIN="${TRIM_APPDEST}/bin/ycfmg"
ETC="${TRIM_PKGETC}"
VAR="${TRIM_PKGVAR}"
CFG="${ETC}/config.yaml"
ENVF="${ETC}/app.env"
PORT="${TRIM_SERVICE_PORT:-8686}"

mkdir -p "${ETC}" "${VAR}/thumbs" "${TRIM_PKGHOME}" 2>/dev/null
chmod +x "${BIN}" 2>/dev/null

if [ ! -f "${CFG}" ] && [ -f "${TRIM_APPDEST}/etc/config.example.yaml" ]; then
    cp "${TRIM_APPDEST}/etc/config.example.yaml" "${CFG}"
fi

if [ -f "${CFG}" ]; then
    sed -i "0,/^  port:/s|^  port:.*|  port: ${PORT}|" "${CFG}"
    sed -i "s|^data_dir:.*|data_dir: ${VAR}|" "${CFG}"
fi

# 运行时环境（免登录 + 端口）
cat > "${ENVF}" <<EOF
# 由安装流程生成，请勿手工修改
YCFMG_PORT="${PORT}"
YCFMG_ADMIN_FORCE="0"
EOF
chmod 600 "${ENVF}"

echo "YCFMG 安装完成：端口 ${PORT}，数据目录 ${VAR}"
echo "免登录模式：浏览器直接打开 http://设备IP:${PORT} 即可使用"
exit 0