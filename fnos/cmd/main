#!/bin/bash
# YCFMG 生命周期控制脚本：start / stop / status（飞牛 fnOS 标准接口）
set -u

LOG_FILE="${TRIM_PKGVAR}/info.log"
PID_FILE="${TRIM_PKGVAR}/app.pid"
BIN="${TRIM_APPDEST}/bin/ycfmg"
CFG="${TRIM_PKGETC}/config.yaml"
ENVF="${TRIM_PKGETC}/app.env"
VAR="${TRIM_PKGVAR}"
PORT="${TRIM_SERVICE_PORT:-8686}"

log_msg() {
    echo "$(date '+%Y-%m-%d %H:%M:%S') - $1" >> "${LOG_FILE}"
}

# 读取安装向导/应用设置写入的环境文件；必须 export 才能传给应用进程
load_env() {
    if [ -f "${ENVF}" ]; then
        set -a
        . "${ENVF}"
        set +a
        PORT="${YCFMG_PORT:-${PORT}}"
    fi
}

prepare() {
    mkdir -p "${TRIM_PKGVAR}" "${TRIM_PKGETC}" "${TRIM_PKGVAR}/thumbs" 2>/dev/null
    if [ ! -f "${CFG}" ] && [ -f "${TRIM_APPDEST}/etc/config.example.yaml" ]; then
        cp "${TRIM_APPDEST}/etc/config.example.yaml" "${CFG}"
        sed -i "0,/^  port:/s|^  port:.*|  port: ${PORT}|" "${CFG}"
        sed -i "s|^data_dir:.*|data_dir: ${VAR}|" "${CFG}"
    fi
    chmod +x "${BIN}" 2>/dev/null
}

check_process() {
    kill -0 "$1" 2>/dev/null
}

is_running() {
    if [ -f "${PID_FILE}" ]; then
        pid=$(head -n 1 "${PID_FILE}" | tr -d '[:space:]')
        if [ -n "${pid}" ] && check_process "${pid}"; then
            return 0
        fi
        rm -f "${PID_FILE}"
    fi
    return 1
}

start_process() {
    prepare
    load_env
    if is_running; then
        log_msg "进程已在运行，跳过启动"
        return 0
    fi
    log_msg "启动 YCFMG，端口 ${PORT}"
    nohup "${BIN}" --config "${CFG}" --data "${VAR}" --port "${PORT}" >> "${LOG_FILE}" 2>&1 &
    echo $! > "${PID_FILE}"
    sleep 2
    if is_running; then
        log_msg "启动成功 pid=$(cat "${PID_FILE}")"
        # 一次性标记：安装向导/设置页提交的密码只需重置一次，避免覆盖用户在应用内改的密码
        if [ -f "${ENVF}" ]; then
            sed -i "s|^YCFMG_ADMIN_FORCE=1|YCFMG_ADMIN_FORCE=0|" "${ENVF}" 2>/dev/null
        fi
        return 0
    fi
    log_msg "启动失败，请查看 ${LOG_FILE}"
    return 1
}

stop_process() {
    if [ -f "${PID_FILE}" ]; then
        pid=$(head -n 1 "${PID_FILE}" | tr -d '[:space:]')
        if [ -n "${pid}" ] && check_process "${pid}"; then
            log_msg "停止进程 pid=${pid}"
            kill -TERM "${pid}" 2>/dev/null
            count=0
            while check_process "${pid}" && [ ${count} -lt 15 ]; do
                sleep 1
                count=$((count + 1))
            done
            if check_process "${pid}"; then
                kill -KILL "${pid}" 2>/dev/null
            fi
        fi
        rm -f "${PID_FILE}"
    fi
    log_msg "已停止"
    return 0
}

case "${1:-}" in
    start)
        start_process || exit 1
        exit 0
        ;;
    stop)
        stop_process || exit 1
        exit 0
        ;;
    status)
        if is_running; then
            exit 0
        fi
        exit 3
        ;;
    *)
        exit 1
        ;;
esac